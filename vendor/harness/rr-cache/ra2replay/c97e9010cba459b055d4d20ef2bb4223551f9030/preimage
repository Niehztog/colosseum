    VectorCopy(ent->avelocity, body->avelocity);
    body->solid = ent->solid;
    body->clipmask = ent->clipmask;
    body->owner = ent->owner;
    body->groundentity = ent->groundentity;
    ent->movetype = MOVETYPE_TOSS;

