// gamex86.dll: 100095F8..10009644
// gamei386.so: 000151B0..0001520C
bool FacingIdeal(edict_t *self)
{
    float   delta;

    delta = anglemod(self->s.angles[YAW] - self->ideal_yaw);
    if (delta > 45 && delta < 315)
        return false;
    return true;
}


