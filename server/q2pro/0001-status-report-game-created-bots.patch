+/*
+===============
+SV_FakeClientInfo
+
+Reports a client slot that the GAME has filled but the engine has no
+connection for -- a bot.
+
+Game libraries that implement bots the way Gladiator did, and every Quake II
+mod descended from it, create them entirely inside the game: the bot is given
+one of the game's client edicts and its ClientConnect runs, but nothing is ever
+connected, so svs.client_pool holds no client_t for that slot.  SV_StatusString
+and SV_CountClients walk sv_clientlist, which is fed only by SV_DirectConnect,
+so such a bot appears in neither the browser's player list nor its count, while
+the game's own scoreboard shows it.  This reports it so the two agree.
+
+The test is that the game has the client edict in use while the engine has no
+connection for the slot.  Only the game knows whether a bot is there; `inuse`
+is the game's own answer and is trustworthy exactly when the game says it
+maintains the field, which is GMF_PROPERINUSE -- the same condition
+SV_BuildClientFrame applies before believing `inuse`.  A slot in any state
+other than cs_free belongs to a real connection (cs_zombie included: its
+client_t is still reserved) and is left to the loop that handles those.
+
+Nothing is allocated, registered or remembered here.  This is a read, performed
+while a status request is being answered, of state the game maintains anyway --
+which is why it needs no cooperation from the game library and cannot affect
+who may connect, what is sent, or when a client times out.
+
+Returns false when the slot holds no such client; `name` and `frags` may be
+NULL when only the test is wanted.
+===============
+*/
+bool SV_FakeClientInfo(int slot, const char **name, int *frags)
+{
+    static char     namebuf[MAX_CLIENT_NAME];
+    const edict_t   *ent;
+    const char      *cs;
+    size_t          len;
+
+    if (!sv_status_show_bots->integer)
+        return false;
+
+    if (!ge || sv.state != ss_game || !svs.client_pool)
+        return false;
+
+    if (!(g_features->integer & GMF_PROPERINUSE))
+        return false;
+
+    if (slot < 0 || slot >= svs.maxclients)
+        return false;
+
+    if (svs.client_pool[slot].state != cs_free)
+        return false;
+
+    ent = EDICT_NUM(slot + 1);
+    if (!ent->inuse || !ent->client)
+        return false;
+
+    if (name) {
+        // the playerskins configstring is "name\model/skin", and the game
+        // writes it for its bots too -- Gladiator-derived ones re-issue it
+        // after every level change because the engine clears it for slots it
+        // has no connection for.  Indexed through the NEGOTIATED remap, never
+        // a literal, because CS_PLAYERSKINS moves under protocol extensions.
+        cs = sv.configstrings[svs.csr.playerskins + slot];
+        len = strcspn(cs, "\\");
+        if (!len)
+            return false;   // nameless: nothing worth reporting
+        len = min(len, sizeof(namebuf) - 1);
+        memcpy(namebuf, cs, len);
+        namebuf[len] = 0;
+        *name = namebuf;
+    }
+
+    if (frags)
+        *frags = SV_GetEdict_Stat(ent, STAT_FRAGS);
+
+    return true;
+}
+
+/*
+===============
+SV_CountFakeClients
+===============
+*/
+int SV_CountFakeClients(void)
+{
+    int i, count = 0;
+
+    for (i = 0; i < svs.maxclients; i++) {
+        if (SV_FakeClientInfo(i, NULL, NULL)) {
+            count++;
+        }
+    }
+
+    return count;
+}
